  "name": "agent_projects_bp_source",
  "description": "读取本项目原始逐页BP与已审核结构化证据（租户和原入池用户隔离）",
  "inputSchema": {
   "type": "object",
   "properties": {
    "pendingId": {
     "type": "string",
     "description": "原待确认id"
