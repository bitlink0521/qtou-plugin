    },
    "page": {
     "type": "integer",
     "description": "页码，从 1 开始，默认 1；返回 hasMore=true 时取下一页"
    },
    "pageSize": {
     "type": "integer",
     "description": "每页条数 1–50，默认 20"
    }
   }
  }
 },
 {
  "name": "agent_risk_alerts_create",
  "description": "场景③：员工逐条确认后写入一条风险预警。risk_state 默认留空（与网页新建一致，riskStateLabel=null）；可选传 state=网页字典 risk_state 值，字典外返回 INVALID_ARGUMENT。未确认禁止调用；同项目同事件已有 Agent 写入、尚未关闭（未设置/告警/跟进）的预警时不重复写（员工网页手建的不算），返回 duplicate=true。意见结论 = 固定头「AI 预警初判，需投后经理复核」+ 调用方只传的正文 conclusion（≤300 字，按字计；不得带网址或 [n] 索引，超限/违规返回 INVALID_ARGUMENT、不写库）+ 服务端按 sources 生成的「出处：[1] URL；[2] URL」（URL 原样完整；固定头和出处索引不计 300）；响应带 bodyChars、indexChars。明细放 sources，事件描述 matters 最多 255 字",
  "inputSchema": {
   "type": "object",
   "properties": {
    "projectId": {
     "type": "string",
     "description": "项目 id（须属本租户）"
    },
    "theme": {
     "type": "string",
     "description": "事件主题（≤100 字；同项目同主题、Agent 写入且未关闭的预警视为重复）"
    },
    "riskType": {
     "type": "string",
     "description": "风险类型，服务端映射到网页字典 risk_type：财务→财务风险；公告/法律/合规/政策(policy)/监管→法律合规风险；舆情/突发→突发事项；业务→业务风险；指标→指标预警；重大变动；其他→其他风险。不在表内返回 INVALID_ARGUMENT、不写库"
    },
    "grade": {
     "type": "string",
     "description": "high|medium|low（按场景③分级表）"
    },
    "rule": {
     "type": "string",
     "description": "可选：命中的分级条款原文，如「营收同比降 ≥50%」（只在响应里回显，不写进意见结论；要写请放进 conclusion 正文）"
    },
    "matters": {
     "type": "string",
     "description": "风险事项摘要（≤255 字）"
    },
    "conclusion": {
     "type": "string",
     "description": "意见结论正文：只写结论摘要（必填，≤300 字，按字计）。不得含网址（http(s):// 或 www.）、「[n]」索引或「出处：」段——出处索引由服务端按 sources 生成拼在后面、不计 300；违规或超限返回 INVALID_ARGUMENT（提示正文上限 300 字与实际字数）、不写库"
    },
    "evidence": {
     "type": "string",
     "description": "旧参数名，等同 conclusion（只在未传 conclusion 时使用）"
    },
    "state": {
     "type": "string",
     "description": "可选：网页字典 risk_state 值（relieve|ignore|follow_up|alarm）；不传则留空（与网页新建一致）；字典外返回 INVALID_ARGUMENT"
    },
    "eventDate": {
     "type": "string",
     "description": "可选：风险发生日期（YYYY-MM-DD）。含季报缺报出处时取其截止日，传值也须匹配（多季默认最新截止日）。其余：须匹配外网发布日或财务报告期末；仅外网默认最早发布日，仅财务默认本期期末，外网+财务须指定。不符/晚于今天不写库"
    },
    "confirmed": {
     "type": "boolean",
     "description": "员工已逐条确认才传 true；否则拒绝且不写库"
    },
    "sources": {
     "type": "array",
     "description": "出处（至少 1 条）：外网 {title,url,date,excerpt}；财务 {recordId,field,value,formula}；缺报 {kind:missing_quarterly_report,quarter:2026Q3}。缺报须已过租户配置截止日且无未删除季报（任意状态均算已报），dueDate 由服务端计算；同一事件多源并列；财务出处每条都须有 recordId、field（纯列名）、value、formula 四项，缺一项返回 INVALID_ARGUMENT 不写库。季报缺报只填 kind=missing_quarterly_report、quarter，不填财务四项。",
     "items": {
      "type": "object",
      "properties": {
       "title": {
        "type": "string",
        "description": "外网：来源标题"
       },
       "url": {
        "type": "string",
        "description": "外网：可打开的完整 http(s) 链接（ASCII、无空格，中文须百分号编码；原样进出处索引，不计正文 300 字）"
       },
       "date": {
        "type": "string",
        "description": "外网：发布日期（必填，YYYY-MM-DD；缺或不是有效日期返回 INVALID_ARGUMENT 不写库）"
       },
       "excerpt": {
        "type": "string",
        "description": "外网：≤200 字原文摘录"
       },
       "recordId": {
        "type": "string",
        "description": "财务：轻投记录 id"
       },
       "field": {
        "type": "string",
        "description": "财务：纯列名（func_project_quarterly_finance 列名或其中文别名），如 business_income、net_assets、total_assets、net_profit、营业收入。只写列名本身：不带季度、不带空格、不带「=值」。正例：business_income。反例：「2026Q3 business_income」「business_income=123」——这两种都会返回 INVALID_ARGUMENT 不写库。季度看 recordId 对应的报告期，不用写进 field；value、formula 另填。"
       },
       "value": {
        "type": "string",
        "description": "财务：字段原值（必填，缺则返回 INVALID_ARGUMENT 不写库）；须与轻投库值一致（容格式差），不符返回 INVALID_ARGUMENT 不写库"
       },
       "formula": {
        "type": "string",
        "description": "财务：计算式"
       },
       "kind": {
        "type": "string",
        "description": "缺报：missing_quarterly_report；同项不填 url 或财务字段"
       },
       "quarter": {
        "type": "string",
        "description": "缺报：必填 YYYYQn，如 2026Q3"
       }
      }
     }
    }
   },
   "required": [
    "projectId",
    "theme",
    "riskType",
    "grade",
    "conclusion",
    "confirmed",
    "sources"
   ]
  }
 },
