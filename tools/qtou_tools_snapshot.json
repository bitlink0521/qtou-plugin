 {
  "name": "agent_health",
  "description": "健康检查（确认 Bearer 有效）",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "agent_bp_parse",
  "description": "场景①：解析 BP 文本为结构化草稿（不入库）。仅按「项目名称：/公司名称：」等标签抽取，无标签时项目名取首个正文行（跳过页码标记）；projectName/companyName 为空时返回 hint，创建待确认项目时请显式传 projectName/companyName",
  "inputSchema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "description": "BP 文本内容"
    }
   },
   "required": [
    "text"
   ]
  }
 },
 {
  "name": "agent_projects_create_pending",
  "description": "场景①：创建待确认项目（不直接入池）。BP 无「项目名称：/公司名称：」标签时，务必传 projectName（项目名）与 companyName（公司全称）；未传时依次取 bpEvidence.fields 的 project.projectName / company.name；带 bpEvidence 而公司全称仍缺失会被拒绝。带 bpEvidence 时返回 evidenceId，后续 bp_fill 可传 evidenceId 复用。返回 confirmToken 只用于确认卡：用户在卡上点确认后才可调 agent_projects_confirm。返回 companyMatch：本租户有同名公司时确认卡只给两个选项（关联已有公司 / 取消后改名），不允许新建同名公司",
  "inputSchema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "description": "BP 文本或项目描述"
    },
    "projectName": {
     "type": "string",
     "description": "项目名称；优先于 BP 文本解析，未传取 bpEvidence 的 project.projectName（无 text 时必填其一）"
    },
    "companyName": {
     "type": "string",
     "description": "公司全称（工商主体，如「XX科技有限公司」）；优先于 BP 文本解析，未传取 bpEvidence 的 company.name；须能在 bpEvidence.document.pages 原文中找到"
    },
    "bpEvidence": {
     "type": "object",
     "properties": {
      "schemaVersion": {
       "type": "integer",
       "enum": [
        1
       ]
      },
      "reviewed": {
       "type": "boolean",
       "enum": [
        true
       ]
      },
      "document": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "asOf": {
         "type": "string",
         "description": "BP披露日期YYYY-MM或YYYY-MM-DD；材料未注明时留空，不用文件导出日期冒充"
        },
        "pages": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "page": {
            "type": "integer",
            "minimum": 1
           },
           "text": {
            "type": "string"
           }
          },
          "required": [
           "page",
           "text"
          ],
          "additionalProperties": false
         }
        }
       },
       "required": [
        "name",
        "pages"
       ],
       "additionalProperties": false
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "nature": {
          "type": "string",
          "enum": [
           "historical_fact",
           "plan",
           "forecast",
           "current_fact"
          ]
         },
         "asOf": {
          "type": "string",
          "description": "与document.asOf相同的披露时点；document.asOf为空时也留空"
         },
         "sources": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "page": {
             "type": "integer",
             "minimum": 1
            },
            "quote": {
             "type": "string",
             "minLength": 5,
             "maxLength": 4000
            }
           },
           "required": [
            "page",
            "quote"
           ],
           "additionalProperties": false
          }
         },
         "field": {
          "type": "string",
          "enum": [
           "project.projectName",
           "project.projectShorthand",
           "project.companyNameEnglish",
           "project.introduction",
           "project.introductionEnglish",
           "project.primaryBusiness",
           "project.yewu",
           "project.businessModel",
