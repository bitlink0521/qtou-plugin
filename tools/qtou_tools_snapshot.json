 {
  "name": "agent_projects_get",
  "description": "场景①：查询待确认项目。返回 companyMatch：本租户有同名公司时确认卡只给两个选项（关联已有公司 / 取消后改名），不允许新建同名公司",
  "inputSchema": {
   "type": "object",
   "properties": {
    "pendingId": {
     "type": "string",
     "description": "待确认 id"
    }
   },
   "required": [
    "pendingId"
   ]
  }
 },
 {
  "name": "agent_projects_confirm",
  "description": "场景①：确认入正式池；补全明确BP字段和同名外部数据，真实Logo优先、缺失则沿用网页占位图；返回entryCompleteness及missingFields，不猜测未知字段。companyMatch.choiceRequired=true 时须先调 agent_projects_company_choose 选 link_existing，否则拒绝",
  "inputSchema": {
   "type": "object",
   "properties": {
    "pendingId": {
     "type": "string",
     "description": "待确认 id"
    },
    "companyFallback": {
     "type": "object",
     "description": "天眼查失败时使用联网检索正文与当前模型核实结果组成的补全CLI schemaVersion=1完整证据；未知工商字段留空"
    },
    "confirmToken": {
     "type": "string",
     "description": "必填：create_pending 随确认卡签发的确认凭证；用户在确认卡上确认后才传，24小时内一次有效"
    }
   },
   "required": [
    "pendingId",
    "confirmToken"
   ]
  }
 },
 {
  "name": "agent_projects_bp_schema",
  "description": "完整BP字段目录：项目/公司/团队/融资/附件；类型、字典、写入边界及页码原文契约",
  "inputSchema": {
   "type": "object",
   "properties": {}
  }
 },
